# CoralCake Environment Variables
# Copy this file to .env.local and fill in your actual values
# Never commit .env.local or any file containing real secrets

# ============================================
# LLM Provider API Keys (Required for /api/run)
# ============================================

# OpenAI API Key - Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Mistral API Key - Get from https://console.mistral.ai/api-keys
MISTRAL_API_KEY=...

# ============================================
# Helicone API Key (Required for LLM observability)
# ============================================

# Helicone Auth - Get from https://helicone.ai/
# Used as proxy for all LLM calls to track usage/latency
HELICONE_API_KEY=sk-helicone-...

# ============================================
# Supabase Configuration (Required for auth & database)
# ============================================

# Supabase Project URL - Get from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Key - Get from your Supabase project settings
# This is safe to expose in client-side code (RLS enforced)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# Application Configuration
# ============================================

# Site URL - Used for auth callbacks
# For local dev: http://localhost:3000
# For production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Node Environment (automatically set by Next.js)
# NODE_ENV=development

# ============================================
# Rate limiting (Optional locally, Required in production)
# ============================================

# Upstash Redis REST credentials — create a free DB at https://console.upstash.com/
# If unset, the app falls back to per-instance in-memory limiting (dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ============================================
# Operational kill switch
# ============================================

# Set to "true" to short-circuit /api/run with a 503 maintenance response.
# Useful to pause all paid LLM calls without redeploying.
DISABLE_LLM_RUNS=false
