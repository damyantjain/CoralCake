# CoralCake Environment Variables
# Copy this file to .env.local for local development

# ===========================
# Supabase Configuration
# ===========================
# Get these from your Supabase project dashboard: https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ===========================
# Site URL Configuration
# ===========================
# This is CRITICAL for authentication redirect flow
# Local development: http://localhost:3000
# Production: https://coralcake.vercel.app (or your production domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===========================
# LLM Provider API Keys
# ===========================
OPENAI_API_KEY=your-openai-api-key
MISTRAL_API_KEY=your-mistral-api-key

# ===========================
# Helicone (LLM Observability)
# ===========================
# Sign up at https://www.helicone.ai/
HELICONE_API_KEY=your-helicone-api-key

# ===========================
# Node Environment
# ===========================
# Automatically set by Next.js, but can be overridden
# NODE_ENV=development
